# En-têtes HTTP de sécurité, au format Netlify.
# Appliqués par Netlify en production, et par `npm run preview` en local (voir vite.config.js).
#
# Content-Security-Policy (CSP) : tout est interdit par défaut (default-src 'none'), puis on autorise
#   type par type ce dont le site a besoin, uniquement depuis le site lui-même ('self').
#   Un script injecté (XSS) ou chargé depuis un autre domaine serait bloqué.
#   base-uri 'self' : pas de détournement des liens relatifs ; form-action 'none' : le formulaire
#   n'envoie rien à un serveur ; frame-ancestors 'none' : le site ne peut pas être affiché dans une
#   autre page (protection contre le « clickjacking »).
#   Trusted Types (require-trusted-types-for 'script' + trusted-types 'none') : le navigateur refuse
#   toute écriture de texte brut dans une fonction dangereuse (innerHTML, outerHTML, eval…), même si
#   un développeur l'ajoutait par erreur plus tard. C'est la protection contre les XSS « basées sur
#   le DOM ». Possible ici parce que le code n'utilise aucune de ces fonctions (voir src/ui/dom.js).
# X-Content-Type-Options : le navigateur respecte le type annoncé d'un fichier, sans le deviner.
# X-Frame-Options : équivalent ancien de frame-ancestors, pour les vieux navigateurs.
# Referrer-Policy : seule l'origine du site est transmise aux sites visités, jamais l'adresse complète.
# Permissions-Policy : DAYOUT n'utilise ni caméra, ni micro, ni position : on les désactive.
# Cross-Origin-Opener-Policy : isole la page des fenêtres ouvertes par d'autres sites.
# HSTS (Strict-Transport-Security) n'est pas défini ici : Netlify l'ajoute déjà, dans une version
# plus forte (includeSubDomains; preload), pour toutes les adresses en .netlify.app.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Fichiers construits par Vite : leur nom contient une empreinte (ex. index-BSTqYCGZ.js),
# ils ne changent jamais, le navigateur peut donc les garder en cache un an.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
